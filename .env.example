# ─── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
SENTINEL_PUBLIC_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (MinIO local) ─────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sentinel-artifacts
S3_ACCESS_KEY_ID=sentinel
S3_SECRET_ACCESS_KEY=sentinel_secret
S3_FORCE_PATH_STYLE=true

# ─── Encryption (REQUIRED — generate: openssl rand -base64 32) ────────────────
SENTINEL_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_-base64_32

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
AUTH_SECRET=CHANGE_ME_at_least_32_characters_long_random_string
RUNNER_TOKEN=CHANGE_ME_at_least_32_characters_long_random_string
CORS_ORIGINS=http://localhost:3000

# ─── Email (optional — Mailpit ships in docker-compose) ───────────────────────
SMTP_URL=smtp://localhost:1025
MAIL_FROM=sentinel@localhost.dev
# RESEND_API_KEY=re_...

# ─── OAuth (optional) ─────────────────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Runner ───────────────────────────────────────────────────────────────────
RUNNER_ID=runner-1
RUNNER_MAX_SLOTS=2
SANDBOX_STRATEGY=local   # Use 'docker' in production
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.49.1-noble
RUN_MAX_DURATION_MS=1800000
RUNNER_CPUS=1
RUNNER_MEMORY=2g
ARTIFACT_MAX_BYTES=524288000

# ─── AI (Phase 5, optional) ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_DEFAULT=claude-sonnet-5
AI_MODEL_DEEP=claude-opus-5

# ─── Next.js web ──────────────────────────────────────────────────────────────
# Auth.js v5 uses AUTH_SECRET (shared with API above)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
