{
  "name": "@sentinel/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/worker.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@sentinel/db": "workspace:*",
    "@sentinel/shared": "workspace:*",
    "bullmq": "^5.34.1",
    "ioredis": "^5.4.1",
    "pino": "^9.6.0",
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "archiver": "^7.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sentinel/config": "workspace:*",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
