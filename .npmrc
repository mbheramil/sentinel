# Hoist @prisma/* to the workspace root node_modules.
#
# @prisma/client is only a direct dependency of packages/db, but the Next.js web
# app transpiles @sentinel/db via transpilePackages, and Next.js externalises
# @prisma/client (serverExternalPackages) so webpack emits require('@prisma/client')
# rather than inlining it. Node resolves that require from the root node_modules,
# so without hoisting it is not found and the prisma singleton in auth.ts returns
# null for every user — manifesting as "Invalid email or password" on every login.
public-hoist-pattern[]=@prisma/client
public-hoist-pattern[]=@prisma/engines-version
public-hoist-pattern[]=prisma
